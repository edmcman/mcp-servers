MFP_USERNAME=your@email.com
MFP_PASSWORD=yourpassword
# Required: MFP gates credential login behind reCAPTCHA, so username/password
# alone fail with RecaptchaFailed. Grab __Secure-next-auth.session-token from
# a logged-in browser (DevTools → Application → Cookies → www.myfitnesspal.com)
# and paste its value here. Lasts ~30 days.
MFP_SESSION_COOKIE=
NGROK_AUTHTOKEN=your_authtoken_here
NGROK_DOMAIN=your-static-domain.ngrok-free.app
HYDRA_DSN=sqlite:///data/hydra.db?mode=rwc&_fk=true
HYDRA_SYSTEM_SECRET=change-this-to-a-32-plus-char-secret!!
